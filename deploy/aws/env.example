# Copy to deploy/aws/.env on the instance and fill in. Never commit the filled copy.

# --- Hostnames -------------------------------------------------------------
# Both must already resolve to this instance's elastic IP before Caddy starts,
# or Let's Encrypt validation fails and you get a self-signed cert.
WEB_HOST=quorum-gowri.duckdns.org
API_HOST=api.quorum-gowri.duckdns.org
ACME_EMAIL=gowrisankart12@gmail.com

AUTH_URL=https://quorum-gowri.duckdns.org
NEXT_PUBLIC_API_URL=https://api.quorum-gowri.duckdns.org
NEXT_PUBLIC_WS_URL=wss://api.quorum-gowri.duckdns.org/v1/ws

# --- Secrets ---------------------------------------------------------------
# JWT_SECRET and ARTIFACT_SIGNING_SECRET must be identical across web/api/worker.
AUTH_SECRET=
JWT_SECRET=
ARTIFACT_SIGNING_SECRET=

# --- Data ------------------------------------------------------------------
# Neon pooled URL needs ?pgbouncer=true&connection_limit=1 appended.
DATABASE_URL=
DIRECT_URL=
REDIS_URL=

# --- Model -----------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Google sign-in --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Artifact storage (Supabase, S3-compatible) ----------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quorum-artifacts
R2_ENDPOINT=
R2_REGION=us-east-2
R2_ACCOUNT_ID=
