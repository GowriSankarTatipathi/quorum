# ─────────────────────────────────────────────────────────────────────────────
# QUORUM — copy to .env.local and fill in. The services validate this at boot and
# refuse to start if it is wrong, so a config error is a startup failure rather
# than a production incident on the first request that needed the value.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Core infrastructure ──────────────────────────────────────────────────────
# DATABASE_URL is the pooled connection used by running services.
# DIRECT_URL bypasses the pooler and is required by `prisma migrate`.
DATABASE_URL=postgresql://quorum:quorum@localhost:5432/quorum?schema=public
DIRECT_URL=postgresql://quorum:quorum@localhost:5432/quorum?schema=public
REDIS_URL=redis://localhost:6379

# ── API gateway ──────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-thirty-two-characters
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ── Authentication ───────────────────────────────────────────────────────────
# Two distinct secrets on purpose: AUTH_SECRET encrypts the NextAuth session cookie,
# JWT_SECRET (above) signs API access tokens. Compromising one must not imply the
# other. Generate each with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-thirty-two-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# At least ONE sign-in method must be configured or the web app refuses to start.
# Google OAuth — redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic links. Locally these are delivered to Mailpit (docker compose), whose inbox
# is at http://localhost:8025 — no credentials needed.
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=QUORUM <no-reply@quorum.local>

# Access tokens are short-lived and stateless; refresh tokens are single-use and
# rotated, with replay of a spent token revoking the entire family.
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000

# ── LLM providers ────────────────────────────────────────────────────────────
# Leave these blank to run against recorded responses; set ANTHROPIC_API_KEY and the
# pipeline switches to the real model automatically, with no other change. Claude is
# primary for every agent; OpenAI is the cross-provider fallback, which survives both a
# vendor outage and a model systematically confused by one page.
#
# Never commit a real key. This file documents the variable; the value belongs in
# .env.local (git-ignored) or your shell.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# auto (default) = live when a key is present, recorded when not.
# recorded        = always recorded, even with a key. CI uses this so a pull request
#                   never depends on a vendor being up or spends money.
# live            = refuse to start unless a key is present.
QUORUM_LLM_MODE=auto

# Optional per-agent model overrides, so a deployment can retune without a code change.
# QUORUM_MODEL_PLANNER=claude-opus-4
# QUORUM_MODEL_CRITIC=claude-opus-4

LLM_CACHE_TTL_S=3600
LLM_TIMEOUT_MS=60000
LLM_RETRIES_PER_MODEL=2
MAX_PLAN_STEPS=20
PROMPT_REGISTRY_ENV=development
# Page content routinely contains client PII, so request/response bodies are not
# persisted by default. Opt in per environment only for debugging.
PERSIST_LLM_BODIES=false

# ── Browser infrastructure ───────────────────────────────────────────────────
# playwright = local headed Chromium (free, no cloud dependency)
# browserbase = managed Chromium with live-view URLs and session replay
# mock = recorded fixtures, used by CI
BROWSER_DRIVER=playwright
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
MAX_CONCURRENT_SESSIONS=4
SESSION_IDLE_TIMEOUT_MS=60000
RESPECT_ROBOTS_TXT=true

# ── Object storage ───────────────────────────────────────────────────────────
# Cloudflare R2: S3-compatible with zero egress fees, which matters because we
# stream screenshots continuously during live view and again on every replay.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quorum-artifacts
R2_ENDPOINT=http://localhost:9000
# Base URL screenshots are linked from inside an export.
ARTIFACT_BASE_URL=http://localhost:9000/quorum-artifacts

# Local development writes artifacts to disk instead, which needs no credentials at all.
ARTIFACT_ROOT=./.artifacts
ARTIFACT_SIGNING_SECRET=replace-me-with-at-least-thirty-two-characters

# ── Run policy ───────────────────────────────────────────────────────────────
DEFAULT_RUN_BUDGET_USD=0.50
MAX_RUN_DURATION_MS=900000
MAX_RECOVERY_ATTEMPTS_PER_STEP=4
MAX_RECOVERY_ATTEMPTS_PER_RUN=10
VERIFICATION_SAMPLE_RATE=0.2
APPROVAL_TIMEOUT_S=1800
WORKER_HEARTBEAT_MS=10000

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=quorum
POSTHOG_KEY=

# ── Client (inlined into the browser bundle — never put a secret here) ────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/v1/ws
