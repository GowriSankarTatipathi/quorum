{
  "name": "quorum",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e .env.local -- turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,prisma}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,prisma}\"",
    "db:generate": "pnpm --filter @quorum/db exec prisma generate",
    "db:migrate": "pnpm --filter @quorum/db exec prisma migrate dev",
    "db:deploy": "pnpm --filter @quorum/db exec prisma migrate deploy",
    "db:studio": "pnpm --filter @quorum/db exec prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:seed": "pnpm --filter @quorum/db seed",
    "e2e": "bash scripts/e2e.sh",
    "e2e:browser": "pnpm --filter @quorum/integration exec tsx src/01-browser.ts",
    "e2e:actions": "pnpm --filter @quorum/integration exec tsx src/02-actions.ts",
    "e2e:db": "pnpm --filter @quorum/integration exec tsx src/03-database.ts",
    "e2e:queue": "pnpm --filter @quorum/integration exec tsx src/04-queue-storage.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "prettier-plugin-prisma": "^5.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
